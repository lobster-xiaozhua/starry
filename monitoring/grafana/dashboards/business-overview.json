{
  "annotations": { "list": [] },
  "title": "Starry Business Overview",
  "uid": "starry-business-overview",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "title": "登录成功率",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{path=\"/api/auth/login\", status_code=~\"2..\"}[5m])) / sum(rate(http_requests_total{path=\"/api/auth/login\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "认证 4xx 率",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{path=~\"/api/auth/.*\", status_code=~\"4..\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "限流 (429) 速率",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=\"429\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Agent LLM 调用成功率",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(agent_llm_calls_total{status=\"success\"}[5m])) / sum(rate(agent_llm_calls_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Agent 对话创建速率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(agent_conversations_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "LLM 延迟 P50 / P95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(agent_llm_duration_seconds_bucket[5m])) by (le, model))",
          "legendFormat": "P50 {{model}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_llm_duration_seconds_bucket[5m])) by (le, model))",
          "legendFormat": "P95 {{model}}",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Agent 工具调用速率（按状态）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(agent_tool_calls_total[5m])) by (status)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "工具调用失败率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(agent_tool_calls_total{status=\"error\"}[5m])) / sum(rate(agent_tool_calls_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Embed 请求速率（按状态）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(embed_requests_total[5m])) by (status)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Embed 模型状态",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "embed_model_state",
          "refId": "A"
        }
      ]
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s"
}
