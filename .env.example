# ===== Starry 部署环境变量示例 =====
# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录下的 .env

# 对外访问源（浏览器实际访问前端的地址）。用于后端/agent 的 CORS 白名单。
# 本地默认 http://localhost；部署到域名时改为 https://your-domain.com
PUBLIC_ORIGIN=http://localhost

# 前端容器对外映射端口
FRONTEND_PORT=80

# 必改：JWT 签名密钥，前后端/agent 必须一致。请用强随机值，例如：
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# 数据库（容器网络内使用 postgres 服务名）
DB_USER=login_user
DB_PASSWORD=login_pass_2026
DB_NAME=login_system

# Redis（容器网络内使用 redis 服务名）
REDIS_PASSWORD=

# 运行环境与日志。APP_ENV=production 时后端启用配置 fail-fast 校验并输出 JSON 日志；
# LOG_LEVEL 留空按环境推导（生产 info，其它 debug）。
APP_ENV=production
LOG_LEVEL=info

# 管理员初始账号（首次启动自动建库）
# 密码：APP_ENV=production 时为必填（留空会让后端拒绝启动，避免拿到弱口令或登录不进去）；
#       APP_ENV=development 时留空会自动生成随机密码并打印到后端日志（docker compose logs backend）。
#       仅首次建库生效，请确保足够强。
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# LLM（Agent 工作模式依赖）。不配置则对话功能不可用，但不影响其余功能。
LLM_API_KEY=
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-3.0-flash

# 后端 → Agent 服务内部调用的共享令牌（知识库向量化等内部端点鉴权）。
# 建议改成随机值，且前后端/agent 必须一致：openssl rand -hex 16
AGENT_INTERNAL_TOKEN=starry-internal

# 后端 → 独立 embed 向量化服务的地址（知识库 RAG 入库/检索走此服务，与对话服务解耦）。
EMBED_URL=http://embed:3002

# ===== 知识库 RAG（可选）=====
# 向量化由独立的 embed 服务（services/embed）用本地免费模型（Xenova/all-MiniLM-L6-v2）完成，
# 无需任何外部密钥。仅首次调用时自动下载模型（约 25MB），与对话 / Agent 服务完全解耦——
# 嵌入模型下载被网络拦截时只影响知识库入库，不会拖垮对话。
# 受限网络下可设置 HuggingFace 镜像源以绕过直连失败：
# HF_ENDPOINT=https://hf-mirror.com
# 模型缓存持久化到卷，避免重建后重新下载：
# TRANSFORMERS_CACHE=/data/models

# ===== 长程任务 / 多 Agent 团队（可选，开箱即用示例见 services/agent/src/config/agents.config.ts）=====
# 主调度 supervisor 会按需把任务委派给 researcher/writer/coder/analyst 四个子 agent。
# 子 agent 定义与工具白名单均可在该配置文件内自由增删，无需改动编排代码。
