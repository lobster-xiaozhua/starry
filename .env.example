# ===== Starry 部署环境变量示例 =====
# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录下的 .env

# 对外访问源（浏览器实际访问前端的地址）。用于后端/agent 的 CORS 白名单。
# 本地默认 http://localhost；部署到域名时改为 https://your-domain.com
PUBLIC_ORIGIN=http://localhost

# 前端容器对外映射端口
FRONTEND_PORT=80

# 必改：JWT 签名密钥，前后端/agent 必须一致。请用强随机值，例如：
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# 数据库（容器网络内使用 postgres 服务名）
DB_USER=login_user
DB_PASSWORD=login_pass_2026
DB_NAME=login_system

# Redis（容器网络内使用 redis 服务名）
REDIS_PASSWORD=

# 管理员初始账号（首次启动自动建库）
# 密码：留空则自动生成随机密码并打印到后端日志（docker compose logs backend）；
#       如需固定密码，在此设置（仅首次建库生效，请确保足够强）。
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# LLM（Agent 工作模式依赖）。不配置则对话功能不可用，但不影响其余功能。
LLM_API_KEY=
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-3.0-flash
