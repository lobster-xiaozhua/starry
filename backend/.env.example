# 后端独立运行所需环境变量（docker-compose 已统一在根目录 .env 管理，此处为其子集说明）。
# 本地直接运行 go run ./cmd/server 时，可 source 此文件。

PORT=8080
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=login_user
DB_PASSWORD=your-db-password
DB_NAME=login_system
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
# 必填：JWT 签名密钥，与 Agent 服务必须一致。留空时启动会生成随机密钥并告警（仅限本地开发）。
JWT_SECRET=your-random-64-char-secret
# CORS 白名单：逗号分隔的来源列表。留空表示仅同源。生产部署填前端实际域名。
CORS_ORIGINS=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# 上传目录：容器内建议挂载持久卷，例如 /data/uploads
UPLOAD_DIR=uploads
# 运行环境：development | production。production 会启用配置 fail-fast 校验与 JSON 日志。
APP_ENV=development
# 日志级别：debug | info | warn | error。留空时按环境推导（生产 info，其它 debug）。
LOG_LEVEL=
# 向量化服务地址（知识库 RAG 走独立的 embed 服务，与对话服务解耦）。本地直跑后端时按需修改。
EMBED_URL=http://embed:3002
